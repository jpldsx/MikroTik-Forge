# MikroTik Forge 1.0.0 - RouterOS v7 configuration
# Target: RouterOS 7.x   Multi-WAN: pcc   VLANs: 2   QoS: htb
#
# Apply (recommended - this script assumes an empty configuration):
#   1) Upload this file to the router (Winbox > Files, or scp).
#   2) /system reset-configuration no-defaults=yes skip-backup=yes run-after-reset=forge.rsc
#   Rename the file to forge.rsc first, or change the name above.
# Reach the router afterwards at the LAN address below (or via Winbox MAC if you have no LAN address).
# Test in Safe Mode first when applying by hand (Ctrl+X in the terminal).

# ---- System
/system identity set name=edge
/system clock set time-zone-name=Asia/Shanghai
/system ntp client set enabled=yes servers=162.159.200.1
/ip dns set servers=1.1.1.1 allow-remote-requests=yes
/ip dns static add name=nas.lan address=192.168.88.20
/ip settings set tcp-syncookies=yes
# (needs the ipv6 package on v6; harmless to skip)
/ipv6 settings set disable-ipv6=yes

# ---- Interface lists
/interface list add name=WAN
/interface list add name=LAN

# ---- WAN interfaces
/interface list member add list=WAN interface=ether1
/interface list member add list=WAN interface=ether6

# ---- LAN bridge + VLAN filtering
/interface bridge add name=bridge comment="LAN bridge" vlan-filtering=no
/interface bridge port add bridge=bridge interface=ether2 pvid=1 frame-types=admit-only-untagged-and-priority-tagged ingress-filtering=yes comment=LAN
/interface bridge port add bridge=bridge interface=ether3 pvid=10 frame-types=admit-only-untagged-and-priority-tagged ingress-filtering=yes comment="VLAN 10 access"
/interface bridge port add bridge=bridge interface=ether5 pvid=1 frame-types=admit-only-vlan-tagged ingress-filtering=yes comment=trunk
/interface bridge port add bridge=bridge interface=ether4 pvid=30 frame-types=admit-only-untagged-and-priority-tagged ingress-filtering=yes comment="VLAN 30 access"
/interface list member add list=LAN interface=bridge
/interface vlan add name=vlan10-work interface=bridge vlan-id=10 comment=work
/interface list member add list=LAN interface=vlan10-work
/interface bridge vlan add bridge=bridge vlan-ids=10 tagged=bridge,ether5 untagged=ether3 comment=work
/interface vlan add name=vlan30-guest interface=bridge vlan-id=30 comment=guest
/interface list member add list=LAN interface=vlan30-guest
/interface bridge vlan add bridge=bridge vlan-ids=30 tagged=bridge untagged=ether4 comment=guest

# ---- IP addressing + DHCP
/ip address add address=192.168.88.1/24 interface=bridge comment=LAN
/ip pool add name=pool-lan ranges=192.168.88.10-192.168.88.254
/ip dhcp-server add name=dhcp-lan interface=bridge address-pool=pool-lan lease-time=1d disabled=no
/ip dhcp-server network add address=192.168.88.0/24 gateway=192.168.88.1 dns-server=192.168.88.1
/ip address add address=192.168.10.1/24 interface=vlan10-work comment=work
/ip pool add name=pool-vlan10-work ranges=192.168.10.10-192.168.10.254
/ip dhcp-server add name=dhcp-vlan10-work interface=vlan10-work address-pool=pool-vlan10-work lease-time=1d disabled=no
/ip dhcp-server network add address=192.168.10.0/24 gateway=192.168.10.1 dns-server=192.168.10.1
/ip address add address=192.168.30.1/24 interface=vlan30-guest comment=guest
/ip pool add name=pool-vlan30-guest ranges=192.168.30.10-192.168.30.254
/ip dhcp-server add name=dhcp-vlan30-guest interface=vlan30-guest address-pool=pool-vlan30-guest lease-time=1d disabled=no
/ip dhcp-server network add address=192.168.30.0/24 gateway=192.168.30.1 dns-server=192.168.30.1
/ip dhcp-server lease add address=192.168.88.20 mac-address=AA:BB:CC:DD:EE:01 server=dhcp-lan comment=PC

# ---- WireGuard (v7)
/interface wireguard add name=wg0 listen-port=51820 comment="private key is generated by the router"
/ip address add address=10.99.0.1/24 interface=wg0
/interface list member add list=LAN interface=wg0
# Show the router's public key with: /interface wireguard print

# ---- WAN addressing + routing (pcc)
/routing table add name=to_Fiber fib
/routing table add name=to_LTE fib
/ip address add address=203.0.113.2/30 interface=ether1 comment=Fiber
/ip dhcp-client add interface=ether6 use-peer-dns=no use-peer-ntp=no disabled=no comment=LTE add-default-route=no script=":if (\$bound=1) do={ :local gw \$\"gateway-address\"; /ip route remove [find where comment~\"^PCC-LTE-\"]; /ip route add dst-address=0.0.0.0/0 gateway=\$gw distance=2 check-gateway=ping comment=PCC-LTE-main; /ip route add dst-address=0.0.0.0/0 gateway=\$gw distance=1 routing-table=to_LTE check-gateway=ping comment=PCC-LTE-own; /ip route add dst-address=0.0.0.0/0 gateway=\$gw distance=3 routing-table=to_Fiber check-gateway=ping comment=PCC-LTE-fb-Fiber; }"
/ip route add dst-address=0.0.0.0/0 gateway=203.0.113.1 distance=1 check-gateway=ping comment=PCC-Fiber-main
/ip route add dst-address=0.0.0.0/0 gateway=203.0.113.1 distance=1 routing-table=to_Fiber check-gateway=ping comment=PCC-Fiber-own
/ip route add dst-address=0.0.0.0/0 gateway=203.0.113.1 distance=2 routing-table=to_LTE check-gateway=ping comment=PCC-Fiber-fb-LTE

# ---- Address lists
/ip firewall address-list add list=LOCAL_NETS address=192.168.88.0/24 comment=LAN
/ip firewall address-list add list=LOCAL_NETS address=192.168.10.0/24 comment="VLAN 10"
/ip firewall address-list add list=LOCAL_NETS address=192.168.30.0/24 comment="VLAN 30"
/ip firewall address-list add list=LOCAL_NETS address=10.99.0.0/24 comment=WireGuard
/ip firewall address-list add list=GAMING_DEVICES address=192.168.88.20
/ip firewall address-list add list=BOGONS address=0.0.0.0/8
/ip firewall address-list add list=BOGONS address=127.0.0.0/8
/ip firewall address-list add list=BOGONS address=224.0.0.0/3
/ip firewall address-list add list=MGMT_WAN address=198.51.100.7

# ---- Mangle
/ip firewall mangle add chain=prerouting action=accept dst-address-list=LOCAL_NETS in-interface-list=LAN comment="PCC: keep LAN-to-LAN traffic in main table"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface=ether1 connection-mark=no-mark new-connection-mark=Fiber_conn passthrough=yes comment="PCC: replies in via Fiber"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface=ether6 connection-mark=no-mark new-connection-mark=LTE_conn passthrough=yes comment="PCC: replies in via LTE"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface-list=LAN dst-address-type=!local connection-mark=no-mark per-connection-classifier=both-addresses-and-ports:4/0 new-connection-mark=Fiber_conn passthrough=yes comment="PCC: new LAN connections -> Fiber"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface-list=LAN dst-address-type=!local connection-mark=no-mark per-connection-classifier=both-addresses-and-ports:4/1 new-connection-mark=Fiber_conn passthrough=yes comment="PCC: new LAN connections -> Fiber"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface-list=LAN dst-address-type=!local connection-mark=no-mark per-connection-classifier=both-addresses-and-ports:4/2 new-connection-mark=Fiber_conn passthrough=yes comment="PCC: new LAN connections -> Fiber"
/ip firewall mangle add chain=prerouting action=mark-connection in-interface-list=LAN dst-address-type=!local connection-mark=no-mark per-connection-classifier=both-addresses-and-ports:4/3 new-connection-mark=LTE_conn passthrough=yes comment="PCC: new LAN connections -> LTE"
/ip firewall mangle add chain=prerouting action=mark-routing in-interface-list=LAN connection-mark=Fiber_conn new-routing-mark=to_Fiber passthrough=no comment="PCC: route Fiber connections via to_Fiber"
/ip firewall mangle add chain=prerouting action=mark-routing in-interface-list=LAN connection-mark=LTE_conn new-routing-mark=to_LTE passthrough=no comment="PCC: route LTE connections via to_LTE"
/ip firewall mangle add chain=output action=mark-routing connection-mark=Fiber_conn new-routing-mark=to_Fiber passthrough=no comment="PCC: router traffic Fiber"
/ip firewall mangle add chain=output action=mark-routing connection-mark=LTE_conn new-routing-mark=to_LTE passthrough=no comment="PCC: router traffic LTE"
/ip firewall mangle add chain=forward src-address-list=GAMING_DEVICES protocol=udp out-interface-list=WAN action=mark-packet new-packet-mark=gaming_up passthrough=no comment="QoS gaming: gaming devices"
/ip firewall mangle add chain=forward protocol=udp dst-port=7000-8000,8180-8181 out-interface-list=WAN action=mark-packet new-packet-mark=gaming_up passthrough=no comment="QoS gaming: game UDP ports"
/ip firewall mangle add chain=forward protocol=udp dst-port=53,3478-3481,5060,5061,8801-8810,19302-19309 out-interface-list=WAN action=mark-packet new-packet-mark=realtime_up passthrough=no comment="QoS realtime: DNS/VoIP/video-call UDP"
/ip firewall mangle add chain=forward protocol=tcp dst-port=53 out-interface-list=WAN action=mark-packet new-packet-mark=realtime_up passthrough=no comment="QoS realtime: DNS over TCP"
/ip firewall mangle add chain=forward protocol=icmp out-interface-list=WAN action=mark-packet new-packet-mark=realtime_up passthrough=no comment="QoS realtime: ICMP"
/ip firewall mangle add chain=forward protocol=tcp dst-port=80,443 out-interface-list=WAN action=mark-packet new-packet-mark=web_up passthrough=no comment="QoS web: web"
/ip firewall mangle add chain=forward protocol=udp dst-port=443 out-interface-list=WAN action=mark-packet new-packet-mark=web_up passthrough=no comment="QoS web: QUIC"
/ip firewall mangle add chain=forward out-interface-list=WAN action=mark-packet new-packet-mark=default_up passthrough=no comment="QoS default class"
/ip firewall mangle add chain=forward dst-address-list=GAMING_DEVICES protocol=udp in-interface-list=WAN action=mark-packet new-packet-mark=gaming_down passthrough=no comment="QoS gaming: gaming devices"
/ip firewall mangle add chain=forward protocol=udp src-port=7000-8000,8180-8181 in-interface-list=WAN action=mark-packet new-packet-mark=gaming_down passthrough=no comment="QoS gaming: game UDP ports"
/ip firewall mangle add chain=forward protocol=udp src-port=53,3478-3481,5060,5061,8801-8810,19302-19309 in-interface-list=WAN action=mark-packet new-packet-mark=realtime_down passthrough=no comment="QoS realtime: DNS/VoIP/video-call UDP"
/ip firewall mangle add chain=forward protocol=tcp src-port=53 in-interface-list=WAN action=mark-packet new-packet-mark=realtime_down passthrough=no comment="QoS realtime: DNS over TCP"
/ip firewall mangle add chain=forward protocol=icmp in-interface-list=WAN action=mark-packet new-packet-mark=realtime_down passthrough=no comment="QoS realtime: ICMP"
/ip firewall mangle add chain=forward protocol=tcp src-port=80,443 in-interface-list=WAN action=mark-packet new-packet-mark=web_down passthrough=no comment="QoS web: web"
/ip firewall mangle add chain=forward protocol=udp src-port=443 in-interface-list=WAN action=mark-packet new-packet-mark=web_down passthrough=no comment="QoS web: QUIC"
/ip firewall mangle add chain=forward in-interface-list=WAN action=mark-packet new-packet-mark=default_down passthrough=no comment="QoS default class"

# ---- NAT
/ip firewall nat add chain=srcnat action=masquerade out-interface-list=WAN comment="NAT to WAN"
/ip firewall nat add chain=dstnat action=redirect protocol=udp dst-port=53 in-interface-list=LAN dst-address-type=!local to-ports=53 comment="Force clients to use router DNS"
/ip firewall nat add chain=dstnat action=redirect protocol=tcp dst-port=53 in-interface-list=LAN dst-address-type=!local to-ports=53 comment="Force clients to use router DNS"

# ---- Raw
/ip firewall raw add chain=prerouting action=drop in-interface-list=WAN src-address-list=BOGONS comment="drop bogon sources from WAN"

# ---- Firewall filter
/ip firewall filter add chain=input action=accept connection-state=established,related,untracked comment="accept established/related"
/ip firewall filter add chain=input action=drop connection-state=invalid comment="drop invalid"
/ip firewall filter add chain=input action=accept protocol=icmp comment="accept ICMP"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=53,67 in-interface=vlan30-guest comment="guest: DNS/DHCP only"
/ip firewall filter add chain=input action=accept protocol=tcp dst-port=53 in-interface=vlan30-guest comment="guest: DNS/TCP"
/ip firewall filter add chain=input action=drop in-interface=vlan30-guest comment="guest: no access to router"
/ip firewall filter add chain=input action=accept in-interface-list=LAN comment="accept from LAN"
/ip firewall filter add chain=input action=accept protocol=udp dst-port=51820 in-interface-list=WAN comment=WireGuard
/ip firewall filter add chain=input action=accept protocol=tcp dst-port=22,8291 src-address-list=MGMT_WAN in-interface-list=WAN comment="management from whitelisted WAN IPs"
/ip firewall filter add chain=input action=drop comment="drop everything else"
/ip firewall filter add chain=forward action=accept connection-state=established,related,untracked comment="accept established/related"
/ip firewall filter add chain=forward action=drop connection-state=invalid comment="drop invalid"
/ip firewall filter add chain=forward action=drop in-interface=vlan30-guest out-interface-list=LAN comment="guest: isolated from other LANs"
/ip firewall filter add chain=forward action=drop connection-state=new connection-nat-state=!dstnat in-interface-list=WAN comment="drop WAN->LAN unless port-forwarded"

# ---- Queues (htb)
/queue simple add name=limit-vlan10-work target=192.168.10.0/24 max-limit=0/200M comment="work cap (upload/download)"
/queue simple add name=limit-vlan30-guest target=192.168.30.0/24 max-limit=10M/50M comment="guest cap (upload/download)"
/queue type add name=ft-pfifo kind=pfifo pfifo-limit=50
/queue type add name=ft-pcq-down kind=pcq pcq-classifier=dst-address pcq-rate=0 pcq-limit=50KiB pcq-total-limit=2000KiB
/queue type add name=ft-fqcodel kind=fq-codel
/queue tree add name=up-Fiber parent=ether1 max-limit=475M comment="Fiber upload root"
/queue tree add name=gaming-up-Fiber parent=up-Fiber packet-mark=gaming_up priority=1 limit-at=142500k max-limit=475M queue=ft-pfifo
/queue tree add name=realtime-up-Fiber parent=up-Fiber packet-mark=realtime_up priority=2 limit-at=71250k max-limit=475M queue=ft-pfifo
/queue tree add name=web-up-Fiber parent=up-Fiber packet-mark=web_up priority=4 limit-at=118750k max-limit=475M queue=ft-fqcodel
/queue tree add name=default-up-Fiber parent=up-Fiber packet-mark=default_up priority=6 limit-at=47500k max-limit=475M queue=ft-fqcodel
/queue tree add name=up-LTE parent=ether6 max-limit=19M comment="LTE upload root"
/queue tree add name=gaming-up-LTE parent=up-LTE packet-mark=gaming_up priority=1 limit-at=5700k max-limit=19M queue=ft-pfifo
/queue tree add name=realtime-up-LTE parent=up-LTE packet-mark=realtime_up priority=2 limit-at=2850k max-limit=19M queue=ft-pfifo
/queue tree add name=web-up-LTE parent=up-LTE packet-mark=web_up priority=4 limit-at=4750k max-limit=19M queue=ft-fqcodel
/queue tree add name=default-up-LTE parent=up-LTE packet-mark=default_up priority=6 limit-at=1900k max-limit=19M queue=ft-fqcodel
/queue tree add name=down-total parent=bridge max-limit=551M comment="download root"
/queue tree add name=gaming-down parent=down-total packet-mark=gaming_down priority=1 limit-at=165300k max-limit=551M queue=ft-pfifo
/queue tree add name=realtime-down parent=down-total packet-mark=realtime_down priority=2 limit-at=82650k max-limit=551M queue=ft-pfifo
/queue tree add name=web-down parent=down-total packet-mark=web_down priority=4 limit-at=137750k max-limit=551M queue=ft-pcq-down
/queue tree add name=default-down parent=down-total packet-mark=default_down priority=6 limit-at=55100k max-limit=551M queue=ft-pcq-down

# ---- Management hardening
/ip service set telnet disabled=yes
/ip service set ftp disabled=yes
/ip service set www disabled=yes
/ip service set api disabled=yes
/ip service set api-ssl disabled=yes
/ip service set ssh address=192.168.88.0/24,192.168.10.0/24,192.168.30.0/24,10.99.0.0/24,198.51.100.7
/ip service set winbox address=192.168.88.0/24,192.168.10.0/24,192.168.30.0/24,10.99.0.0/24,198.51.100.7
/ip ssh set strong-crypto=yes
/ip neighbor discovery-settings set discover-interface-list=LAN
/tool mac-server set allowed-interface-list=LAN
/tool mac-server mac-winbox set allowed-interface-list=LAN
/tool bandwidth-server set enabled=no

# ---- Enable VLAN filtering (last)
/interface bridge set [find where name=bridge] vlan-filtering=yes
